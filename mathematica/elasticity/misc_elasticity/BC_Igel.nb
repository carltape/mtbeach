  RowBox[{"kmin", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kmax", "=", "1000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cf", "[", "k_", "]"}], ":=", 
   RowBox[{
    RowBox[{"ColorData", "[", "\"\<Rainbow\>\"", "]"}], "[", 

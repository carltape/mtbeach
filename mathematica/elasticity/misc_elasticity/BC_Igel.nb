        RowBox[{"kmin", ",", "kmax"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Alpha", "[", 
         RowBox[{
          RowBox[{"TmatOFk", "[", 
           RowBox[{"TXISOref", ",", "k"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            StyleBox[
             RowBox[{"\[Pi]", "/", "4"}],
             FontColor->RGBColor[1, 0, 0]]}], "}"}], ",", "MONO"}], "]"}], 
        "/", "Degree"}], ",", 
       RowBox[{
        RowBox[{"\[Beta]T", "[", 
         RowBox[{
          RowBox[{"TmatOFk", "[", 
           RowBox[{"TXISOref", ",", "k"}], "]"}], ",", "ISO"}], "]"}], "/", 
        "Degree"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "kmin", ",", "kmax"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Alpha] (deg)\>\"", ",", "\"\<\[Beta]ISO (deg)\>\""}], 
       "}"}]}], ",", 
     RowBox[{"GridLines", "->", "Automatic"}], ",", 
     RowBox[{"GridLinesStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"GrayLevel", "[", "0.85", "]"}], "]"}]}], ",", 
     RowBox[{"ColorFunction", "->", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "k"}], "}"}], ",", 
        RowBox[{"cf", "[", "k", "]"}]}], "]"}]}], ",", 
     RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
     RowBox[{"PlotStyle", "->", "Thick"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"BarLegend", "[", 
       RowBox[{
        RowBox[{"{", 

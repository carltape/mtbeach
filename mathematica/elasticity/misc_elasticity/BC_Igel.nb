Cell[CellGroupData[{

Cell[TextData[{
 "Note that VTI is the reference matrix form for XISO.",
 StyleBox["\nN",
  FontWeight->"Bold"],
 StyleBox["otes on the Igel map:",
  FontWeight->"Bold"],
 "\nThe blue balls convey that they are relatively close to isotropic.\nGet \
the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "ISO"], TraditionalForm]],ExpressionUUID->
  "5ac1abd4-116a-4ee6-afca-0bba18efad08"],
 " angles for the three balls:\nTTI: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", "ISO"], "=", 
    SuperscriptBox["26.39", 
     StyleBox["o",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "800555d0-1a5b-4535-abf6-9c8fbb963bac"],
 ", VTI: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", "ISO"], "=", 
    SuperscriptBox["13.09", 
     StyleBox["o",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "6b12fd33-a8ee-4849-8711-877d031d5b3d"],
 ", HTI: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", "ISO"], "=", 
    SuperscriptBox["9.81", 
     StyleBox["o",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "e8f55d95-79d5-4480-9d94-798910f88e31"]
}], "Subsubsection",

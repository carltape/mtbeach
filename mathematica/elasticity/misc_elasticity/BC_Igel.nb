Cell[CellGroupData[{

Cell["\<\
Here is modified legends.  
The red 4 makes only every fourth contour value show up. 
The red 1.6  moved up the heading a bit. I fiddled with the Inset parameters \
also, but you already know how to do this.\
\>", "Subsubsection",
 CellChangeTimes->{{3.899749969210069*^9, 
  3.899750112350767*^9}},ExpressionUUID->"87941477-9957-4edb-a147-\

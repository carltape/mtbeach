Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"For", " ", "[", "T", "]"}], "=", "TmatForXISO"}], ",", " ", 
  RowBox[{
   RowBox[{"the", " ", "regular", " ", "axis", " ", "of", " ", 
    RowBox[{
     RowBox[{
      OverscriptBox["U", "_"], "\[SmallCircle]", "T"}], "\[CenterDot]", 
     OverscriptBox[
      SuperscriptBox["U", "T"], "_"]}], " ", "is", " ", "in", " ", "the", " ",
     "direction", " ", "of", " ", 
    RowBox[{
     StyleBox[
      RowBox[{"U", 
       StyleBox["k",
        FontWeight->"Plain"]}]], ".", " ", "If"}], " ", "U"}], " ", "=", " ", 
   RowBox[{"UsHat", "[", 
    RowBox[{"{", 
     RowBox[{"\[Theta]", ",", "\[Sigma]", ",", "\[Phi]"}], "}"}], "]"}]}], 
  ",", " ", 
  RowBox[{"then", "  ", "\[Theta]"}], ",", 
  RowBox[{
  "\[Phi]", " ", "are", " ", "the", " ", "spherical", " ", "coordinates", " ",
    "of", " ", "Uk", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"the", " ", "third", " ", "column", " ", "of", " ", "U"}], ")"}],
     ".", " ", "So"}], " ", "the", " ", "matrix", " ", "for", " ", "the", " ",
    "XISO", " ", "map", " ", "with", " ", "horizontal", " ", "regular", " ", 
   "axis", " ", "in", " ", "the", " ", "\[Theta]", " ", "direction", " ", 
   "is"}]}]], "Subsubsection",

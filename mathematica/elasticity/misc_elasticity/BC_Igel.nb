Cell[BoxData[
 RowBox[{
  RowBox[{"PlotK", "[", "kvec_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"kcolors", ",", "colors"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"kcolors", "=", 
      RowBox[{"Reverse", "[", 
       RowBox[{
        RowBox[{"ColorData", "[", "\"\<Rainbow\>\"", "]"}], "/@", 
        RowBox[{"Subdivide", "[", 
         RowBox[{"0", ",", "1", ",", 
          RowBox[{
           RowBox[{"Length", "[", "kvec", "]"}], "-", "1"}]}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"colors", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", "Black", "}"}], ",", "kcolors"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Legended", "[", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "@", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"fInf", "[", "\[Phi]", "]"}], "}"}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"f", "[", "k", "]"}], "[", "\[Phi]", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "kvec"}], "}"}]}], "]"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Phi]", ",", "0", ",", 
           RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", 
         RowBox[{"Ticks", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", 
              RowBox[{"90", " ", "Degree"}], ",", 
              RowBox[{"45", " ", "Degree"}]}], "]"}], ",", 
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", 
              RowBox[{"60", " ", "Degree"}], ",", 
              RowBox[{"15", " ", "Degree"}]}], "]"}]}], "}"}]}], ",", 
         RowBox[{"PlotStyle", "->", "colors"}]}], "]"}], ",", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"LineLegend", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", "Black", "}"}], ",", 
             RowBox[{"Reverse", "[", "kcolors", "]"}]}], "]"}], ",", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", "\"\<k = \[Infinity]\>\"", "}"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Row", "[", 
                RowBox[{"{", 
                 RowBox[{"\"\<k = \>\"", ",", "#"}], "}"}], "]"}], "&"}], "/@", 
              RowBox[{"Reverse", "[", "kvec", "]"}]}]}], "]"}]}], "]"}], ",", 
         "Right"}], "]"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.995906176916772*^9, 3.995906224834435*^9}, {
  3.995911722243862*^9, 3.995911722637738*^9}, {3.995911781548201*^9, 
  3.995911786385007*^9}},
 CellLabel->

Cell[TextData[{
 StyleBox["Notes on the Igel map:",
  FontWeight->"Bold"],
 "\nYou can believe from the picture that K is correct for the closest XISO \
map.\nLook at the great circular band that has the regular axis of K as its \
pole.\nIts colors are relatively cool\[LongDash]light blues and white."
}], "Subsubsection",

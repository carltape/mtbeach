  RowBox[{
   RowBox[{
    RowBox[{"PaddedForm", "[", 
     RowBox[{"#", ",", 
      RowBox[{"{", 
       RowBox[{"5", ",", "2"}], "}"}]}], "]"}], "&"}], "/@", 
   RowBox[{"Round", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sorted\[Theta]\[Sigma]\[Phi]Minimizers", "[", 
       RowBox[{"Tmat", ",", "\[CapitalSigma]"}], "]"}], "/", "Degree"}], ",", 
     ".1"}], "]"}]}], "]"}], "\[IndentingNewLine]", 

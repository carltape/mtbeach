Cell[CellGroupData[{

Cell[TextData[{
 "Positive definite XISO maps.\nYou can get a pretty big ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "ISO"], TraditionalForm]],ExpressionUUID->
  "f1cd422a-a91c-4089-a929-e6c02aaab9b9"],
 ". Looks like a near-zero eigenvalue might be the culprit.\nI guess you \
cannot say that high symmetry implies low anisotropy.\nDon\[CloseCurlyQuote]t \
run it for 100000 on your first try."
}], "Subsection",
 CellChangeTimes->{{3.9465011393098783`*^9, 3.9465011821410856`*^9}, {
  3.946501212175702*^9, 3.9465012237688613`*^9}, {3.946501300647834*^9, 
  3.9465013611166677`*^9}, {3.946502316877898*^9, 3.946502335284523*^9}, {
  3.9465029610725174`*^9, 
  3.9465030126560526`*^9}},ExpressionUUID->"e9f9f8e6-167f-4692-9ba8-\
57dd7797c153"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"\[Beta]max", ",", "TestMat", ",", "\[Beta]ofI"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Beta]max", "[", "0", "]"}], "=", "0"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"TestMat", "=", 
     RowBox[{
      TagBox[
       RowBox[{"(", "\[NoBreak]", GridBox[{
          {"a", "0", "0", "0", "0", "0"},
          {"0", "a", "0", "0", "0", "0"},
          {"0", "0", "c", "0", "0", "0"},
          {"0", "0", "0", "c", "0", "0"},
          {"0", "0", "0", "0", "e", "0"},
          {"0", "0", "0", "0", "0", "f"}
         },
         GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
         GridBoxSpacings->{"Columns" -> {
             Offset[0.27999999999999997`], {
              Offset[0.7]}, 
             Offset[0.27999999999999997`]}, "Rows" -> {
             Offset[0.2], {
              Offset[0.4]}, 
             Offset[0.2]}}], "\[NoBreak]", ")"}],
       Function[BoxForm`e$, 
        MatrixForm[BoxForm`e$]]], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a", "->", 
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           StyleBox[
            RowBox[{"0", ",", "1"}],
            FontColor->RGBColor[1, 0, 0]], "}"}], "]"}]}], ",", 
        RowBox[{"c", "->", 
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], "]"}]}], ",", 
        RowBox[{"e", "->", 
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], "]"}]}], ",", 
        RowBox[{"f", "->", 
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], "]"}]}]}], "}"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Beta]ofI", "[", "i", "]"}], "=", 
     RowBox[{"\[Beta]T", "[", 
      RowBox[{"TestMat", ",", "ISO"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Beta]max", "[", "i", "]"}], "=", 
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{"\[Beta]ofI", "[", "i", "]"}], ",", 
       RowBox[{"\[Beta]max", "[", 
        RowBox[{"i", "-", "1"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"If", " ", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Beta]ofI", "[", "i", "]"}], ">", 
       RowBox[{"\[Beta]max", "[", 
        RowBox[{"i", "-", "1"}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<i = \>\"", ",", "i", ",", "\"\<, T[i] = \>\"", ",", 
        RowBox[{"MatrixForm", "[", "TestMat", "]"}], ",", 
        "\"\<, \!\(\*SubsuperscriptBox[\(\[Beta]\), \(ISO\), \(T[i]\)]\) = \>\
\"", ",", 
        RowBox[{"Round", "[", 

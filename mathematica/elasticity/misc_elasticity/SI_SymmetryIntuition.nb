Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"XISOregularRots", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"ZRot", "[", "t", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", 
        RowBox[{"-", "\[Pi]"}], ",", "\[Pi]", ",", 
        FractionBox["\[Pi]", "4"]}], "}"}]}], "]"}]}], ";"}], 
  "  "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"XISO2foldRots", ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"XRot", "[", "\[Pi]", "]"}], ".", "#"}], "&"}], "/@", 
    "XISOregularRots"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RefGp", "[", "XISO", "]"}], ":=", 
   RowBox[{"Union", "[", 
    RowBox[{"Join", "[", 
     RowBox[{"XISOregularRots", ",", "XISO2foldRots"}], "]"}], "]"}]}], 
  ";"}]}], "Input",

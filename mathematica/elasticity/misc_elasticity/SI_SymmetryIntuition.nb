Cell[BoxData[
 RowBox[{
  RowBox[{"TextForLeftCosetContaining\[Theta]0\[Sigma]0\[Phi]0", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Theta]0_", ",", "\[Sigma]0_", ",", "\[Phi]0_"}], "}"}], ",", 
    "\[CapitalSigma]_", ",", "eye_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<(\[Theta]0, \[Sigma]0, \[Phi]0) = \>\"", ",", 
      RowBox[{"{", 
       RowBox[{"\[Theta]0", ",", "\[Sigma]0", ",", "\[Phi]0"}], "}"}]}], 
     "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<The coset is \!\(\*StyleBox[\"U\",FontSlant->\"Italic\"]\)\>\"", 
      StyleBox[",",
       FontSize->14,
       FontWeight->"Normal"], 
      RowBox[{
       RowBox[{
        StyleBox["SubscriptBox",
         FontSize->14,
         FontWeight->"Normal"], 
        StyleBox["[",
         FontSize->14,
         FontWeight->"Normal",
         FontSlant->"Italic"], 
        RowBox[{
         StyleBox["\[DoubleStruckCapitalG]",
          FontSize->14,
          FontWeight->"Bold"], 
         StyleBox[",",
          FontSize->14,
          FontWeight->"Bold"], "\[CapitalSigma]"}], "]"}], "//", 
       "DisplayForm"}], ",", 
      "\"\<, where \
\!\(\*StyleBox[\"U\",FontWeight->\"Normal\",FontSlant->\"Italic\"]\) = \
\!\(\*OverscriptBox[StyleBox[\"U\",FontWeight->\"Normal\",FontSlant->\"Italic\
\"], \"^\"]\)(\[Theta]0,\[Sigma]0,\[Phi]0) = \!\(\*SubscriptBox[\(Z\), \(\
\[Theta]0\)]\)\!\(\*SubscriptBox[\(Y\), \
\(\[Phi]0\)]\)\!\(\*SubscriptBox[\(Z\), \(\[Sigma]0\)]\) = \>\"", ",", 
      RowBox[{"MatrixForm", "[", 
       RowBox[{"Round", "[", 
        RowBox[{
         RowBox[{"Chop", "[", 
          RowBox[{"1.", 
           RowBox[{"UsHat", "[", 
            RowBox[{"{", 
             RowBox[{"\[Theta]0", ",", "\[Sigma]0", ",", "\[Phi]0"}], "}"}], 
            "]"}]}], "]"}], ",", ".001"}], "]"}], "]"}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\[Theta]\[Phi]pairs are \>\"", ",", 
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"1.", 
         RowBox[{
          RowBox[{"\[Theta]\[Phi]pairs", "[", 
           RowBox[{"LeftCoset", "[", 
            RowBox[{
             RowBox[{"bbG", "[", "\[CapitalSigma]", "]"}], ",", 
             RowBox[{"UsHat", "[", 
              RowBox[{"{", 
               RowBox[{"\[Theta]0", ",", "\[Sigma]0", ",", "\[Phi]0"}], "}"}],
               "]"}]}], "]"}], "]"}], "/", "Degree"}]}], ",", ".1"}], "]"}], 
      ",", "\"\<, (spherical coordinates of normal vector to yellow \
face)\>\""}], "]"}], ";", "\[IndentingNewLine]", "PrintEye", ";"}], 
   ")"}]}]], "Input",
 CellLabel->
  "In[2450]:=",ExpressionUUID->"ed3135d3-a3fa-4421-96cf-bde2069ef3da"]
}, Open  ]],


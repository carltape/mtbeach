Cell[CellGroupData[{

Cell[TextData[{
 "Looking for a function F of elastic maps that preserves inner products but \
such that for some elastic map T the contour plot of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", "mono", 
    RowBox[{"F", "(", "T", ")"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d169562f-a8f0-4de7-abbf-f726eb0b0a17"],
 " is not congruent to that of ",
 Cell[BoxData[

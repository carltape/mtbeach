Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DiagonalsTopAndBottomFaces", "[", 
    RowBox[{"V_", ",", "\[CapitalSigma]_"}], "]"}], ":=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Thickness", "[", ".004", "]"}], ",", 
         "                                 ", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"#", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Pi]", "+", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ",", "  ", 
              RowBox[{"-", "\[Pi]"}], ",", "0"}], "}"}]}], "}"}], "]"}]}], 
        "}"}], "&"}], "/@", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"ModComplete", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Theta]\[Sigma]\[Phi]0to2\[Pi]", "[", "#", "]"}], "&"}], 
          "/@", 
          RowBox[{"LeftCoset", "[", 
           RowBox[{
            RowBox[{"bbG", "[", "\[CapitalSigma]", "]"}], ",", "V"}], "]"}]}],
          "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "==", "0"}], "   ", "&&", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "==", "0"}]}], "&"}]}], "]"}]}], 
     ",", " ", 
     RowBox[{"(*", " ", 
      StyleBox[
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Theta]", ",", "\[Phi]"}], "}"}], " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}]}],
       FontSize->14,
       FontWeight->"Bold",
       FontColor->RGBColor[1, 0, 0]], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Thickness", "[", ".004", "]"}], ",", 
         RowBox[{"ColorOf\[Theta]\[Sigma]\[Phi]", "[", "#", "]"}], ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"#", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Pi]", "+", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ",", "    ", "\[Pi]", ",", 
              "0"}], "}"}]}], "}"}], "]"}]}], "}"}], "&"}], "/@", 
      RowBox[{"Select", "[", 

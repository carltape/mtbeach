Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"\[Theta]", ",", "\[Sigma]", ",", "\[Phi]"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"UsHat", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Theta]", "+", "\[Pi]"}], ",", "       ", 
      RowBox[{"-", "\[Sigma]"}], ",", 
      RowBox[{"\[Pi]", "-", "\[Phi]"}]}], "}"}], "]"}], "==", 
   RowBox[{
    RowBox[{"UsHat", "[", 
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", "\[Sigma]", ",", "\[Phi]"}], "}"}], "]"}], ".", 
    RowBox[{"XRot", "[", "\[Pi]", "]"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"UsHat", "[", 
    RowBox[{"{", "       ", 
     RowBox[{"\[Theta]", ",", "   ", 
      RowBox[{"\[Sigma]", "+", "t"}], ",", "      ", "\[Phi]"}], " ", "}"}], 
    "]"}], "==", 
   RowBox[{
    RowBox[{"UsHat", "[", 
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", "\[Sigma]", ",", "\[Phi]"}], "}"}], "]"}], ".", 
    RowBox[{"ZRot", "[", "t", "]"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"UsHat", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Theta]", "+", "\[Pi]"}], ",", 
      RowBox[{
       RowBox[{"-", "\[Sigma]"}], "-", "t"}], ",", 
      RowBox[{"\[Pi]", "-", "\[Phi]"}]}], "}"}], "]"}], "==", 
   RowBox[{
    RowBox[{"UsHat", "[", 
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", "\[Sigma]", ",", "\[Phi]"}], "}"}], "]"}], ".", 
    RowBox[{"ZRot", "[", "t", "]"}], ".", 
    RowBox[{"XRot", "[", "\[Pi]", "]"}]}]}], "]"}]}], "Input",

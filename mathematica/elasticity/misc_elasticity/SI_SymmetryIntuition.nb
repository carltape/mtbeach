Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "group", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"group", "[", 
    RowBox[{"\[CapitalSigma]_", ",", "V_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"V", ".", "#", ".", 
      RowBox[{"Transpose", "[", "V", "]"}]}], "&"}], "/@", 
    RowBox[{"RefGp", "[", "\[CapitalSigma]", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"LeftCoset", "[", 
    RowBox[{"group_", ",", "V_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"V", ".", "#"}], "&"}], "/@", "group"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9162382472720003`*^9, 3.9162383779240875`*^9}, 
   3.9162384668243265`*^9, {3.9184020811559258`*^9, 3.9184020819682746`*^9}},

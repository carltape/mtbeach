           RowBox[{
            RowBox[{"bbG", "[", "\[CapitalSigma]", "]"}], ",", "V"}], "]"}]}],
          "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "==", 
           RowBox[{"2", "\[Pi]"}]}], "&&", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "==", "0"}]}], "&"}]}], "]"}]}], 
     ",", " ", 
     RowBox[{"(*", " ", 
      StyleBox[
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Theta]", ",", "\[Phi]"}], "}"}], " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "\[Pi]"}], ",", "0"}], "}"}]}],
       FontSize->14,
       FontWeight->"Bold",
       FontColor->RGBColor[1, 0, 0]], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Thickness", "[", ".003", "]"}], ",", 
         RowBox[{"ColorOf\[Theta]\[Sigma]\[Phi]", "[", "#", "]"}], ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"#", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Pi]", "-", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ",", "    ", "\[Pi]", ",", 
              "\[Pi]"}], "}"}]}], "}"}], "]"}]}], "}"}], "&"}], "/@", 
      RowBox[{"Select", "[", 

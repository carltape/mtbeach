       RowBox[{"\[Sigma]forMin", "[", 
        RowBox[{"Tmat", ",", "\[CapitalSigma]"}], "]"}], "]"}], ",", 
      "\"\<)\>\""}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<The prime minimizer is at       (\>\"", ",", 
      RowBox[{"DegreeText", "[", 
       RowBox[{"\[Theta]forMin", "[", 
        RowBox[{"Tmat", ",", "\[CapitalSigma]"}], "]"}], "]"}], ",", 
      "\"\<, \>\"", ",", 
      RowBox[{"DegreeText", "[", 
       RowBox[{"\[Sigma]forMin", "[", 
        RowBox[{"Tmat", ",", "\[CapitalSigma]"}], "]"}], "]"}], ",", 
      "\"\<, \>\"", ",", 
      RowBox[{"DegreeText", "[", 
       RowBox[{
        RowBox[{"Prime\[Theta]\[Sigma]\[Phi]Minimizer", "[", 
         RowBox[{"Tmat", ",", "\[CapitalSigma]"}], "]"}], "[", 
        RowBox[{"[", "3", "]"}], "]"}], "]"}], ",", "\"\<),   \>\"", ",", 
      RowBox[{
       RowBox[{"SubscriptBox", "[", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<\[Beta]\>\"", ",", "13"}], "]"}], ",", 
         "\[CapitalSigma]"}], "]"}], "//", "DisplayForm"}], ",", 
      "\"\< = \>\"", ",", 
      RowBox[{"DegreeText", "[", 
       RowBox[{"\[Beta]T", "[", 
        RowBox[{"Tmat", ",", "\[CapitalSigma]"}], "]"}], "]"}], ",", 
      "\"\<   \>\"", ",", 
      RowBox[{
       RowBox[{"ColorData", "[", 
        RowBox[{"colorscheme", "[", "\[CapitalSigma]", "]"}], "]"}], "[", 
       FractionBox[
        RowBox[{
         RowBox[{"\[Beta]T", "[", 
          RowBox[{"Tmat", ",", "\[CapitalSigma]"}], "]"}], "/", "Degree"}], 
        RowBox[{"MaxForScaling", "[", 
         RowBox[{"Tmat00", ",", "\[CapitalSigma]"}], "]"}]], "]"}]}], "]"}], 
    ";", "\[IndentingNewLine]", 

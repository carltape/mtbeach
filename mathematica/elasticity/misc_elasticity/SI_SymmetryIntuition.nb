Cell[CellGroupData[{

Cell["\<\
The pairs (\[Theta], \[Phi]) for rotations in the set.  (\[Theta], \[Phi])  \
are spherical coordinates for the third column of the relevant rotation.\
\>", "Subsubsection",
 CellChangeTimes->{{3.9170282220428886`*^9, 3.9170282725803375`*^9}, 
   3.9170283083338585`*^9, {3.9174596637846613`*^9, 

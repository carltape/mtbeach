 RowBox[{
  RowBox[{"TextForWallPaperThroughMinimizers", "[", 
   RowBox[{
   "Tmat_", ",", "Tmat00_", ",", "\[CapitalSigma]_", ",", "plotpoints_", ",", 
    "contourstyle_", ",", "eye_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 

Cell[CellGroupData[{

Cell["Choosing the wallpaper to go through minimizers.", "Section",
 CellChangeTimes->{{3.923418734936863*^9, 3.9234187545004435`*^9}, {
  3.9247073004401665`*^9, 3.924707309464527*^9}, {3.9247073690324965`*^9, 
  3.9247074312889194`*^9}, {3.924707489864027*^9, 3.924707556297535*^9}, {
  3.939858487876616*^9, 3.9398584893351564`*^9}, {3.9399186175798435`*^9, 
  3.9399186385843573`*^9}},ExpressionUUID->"f64e9ed2-bc5c-4810-9b7e-\
6f70ea099496"],

Cell[CellGroupData[{

Cell["\<\
Prime\[Theta]\[Sigma]\[Phi]Minimizer[Tmat, \[CapitalSigma]] is the \
\[CapitalSigma]-minimizer that will appear at the front corner of the \
wallpaper.
If Tmat has more than one closest \[CapitalSigma]-map, then \[Theta]\[Sigma]\
\[Phi]Minimizers[Tmat, \[CapitalSigma]] will not have all the \
\[CapitalSigma]-minimizers.\
\>", "Subsubsection",
 CellChangeTimes->{{3.923418734936863*^9, 3.9234187545004435`*^9}, {
  3.9247073004401665`*^9, 3.924707309464527*^9}, {3.9247073690324965`*^9, 
  3.9247074312889194`*^9}, {3.924707489864027*^9, 3.924707556297535*^9}, {
  3.939858487876616*^9, 3.9398584893351564`*^9}, {3.9399186572357874`*^9, 
  3.9399186587511563`*^9}},ExpressionUUID->"9bff8547-ca93-4871-9857-\
ed68b38b5cee"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "Prime\[Theta]\[Sigma]\[Phi]Minimizer", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Theta]\[Sigma]\[Phi]Minimizers", "[", 
    RowBox[{"Tmat_", ",", "\[CapitalSigma]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Theta]\[Sigma]\[Phi]0to2\[Pi]", "[", "#", "]"}], "&"}], "/@", 
    RowBox[{"LeftCoset", "[", 
     RowBox[{
      RowBox[{"bbG", "[", "\[CapitalSigma]", "]"}], ",", 
      RowBox[{"UT", "[", 
       RowBox[{"Tmat", ",", "\[CapitalSigma]"}], "]"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Sorted\[Theta]\[Sigma]\[Phi]Minimizers", "[", 
    RowBox[{"Tmat_", ",", "\[CapitalSigma]_"}], "]"}], ":=", 
   RowBox[{"Sort", "[", 
    RowBox[{
     RowBox[{"\[Theta]\[Sigma]\[Phi]Minimizers", "[", 
      RowBox[{"Tmat", ",", "\[CapitalSigma]"}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"#1", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "<", 
        RowBox[{"#2", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "||", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"#1", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "==", 
          RowBox[{"#2", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "&&", 
         RowBox[{
          RowBox[{"#1", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "<", 
          RowBox[{"#2", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}]}], "&"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Sorted\[Theta]\[Sigma]\[Phi]Minimizers", "[", 
     RowBox[{"Tmat_", ",", "\[CapitalSigma]_"}], "]"}], ":=", 
    RowBox[{"Sort", "[", 
     RowBox[{
      RowBox[{"\[Theta]\[Sigma]\[Phi]Minimizers", "[", 
       RowBox[{"Tmat", ",", "\[CapitalSigma]"}], "]"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#1", "[", 
          RowBox[{"[", "3", "]"}], "]"}], "<", 
         RowBox[{"#2", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], "||", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"#1", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "==", 
           RowBox[{"#2", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "&&", 
          RowBox[{
           RowBox[{"#1", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "<", 
           RowBox[{"#2", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}]}], "&"}]}], "]"}]}], 
   ";"}], "  ", 
  RowBox[{"(*", " ", 
   StyleBox[
    RowBox[{
    "Use", " ", "this", " ", "if", " ", "the", " ", "linoleum", " ", "is", 
     " ", "otherwise", " ", "too", " ", "high"}],
    FontColor->RGBColor[1, 0, 0]], " ", "*)"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{

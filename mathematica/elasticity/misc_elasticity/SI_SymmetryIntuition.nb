Cell[CellGroupData[{

Cell[TextData[{
 "All XISO maps, positive definite or not.\nIt looks like the limiting value \
for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "ISO"], TraditionalForm]],ExpressionUUID->
  "b1abf5ac-fb89-4312-a012-3c1b3b3ba37d"],
 " might be ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["90", "\[SmallCircle]"], TraditionalForm]],ExpressionUUID->
  "97b3e35e-56e0-4c14-bec6-61189ea4a27d"],
 ".  Looks like a near-zero eigenvalue might be the culprit.\nDon\
\[CloseCurlyQuote]t run it for 100000 on your first try."
}], "Subsection",

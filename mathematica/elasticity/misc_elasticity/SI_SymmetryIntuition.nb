Cell[TextData[{
 "Orthorhombic example for the ",
 StyleBox["Pictures for Elastic Maps",
  FontSlant->"Italic"],
 " paper.\nMust run MinimizationFacts[Tmat, ",
 StyleBox["MONO",
  FontColor->RGBColor[1, 0, 0]],
 "] in order to get \[Beta]."
}], "Subsubsection",

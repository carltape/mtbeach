     RowBox[{
     "\"\<\[CapitalSigma] = \>\"", ",", "\[CapitalSigma]", ",", "\"\<,  \>\"",
       ",", 
      RowBox[{"ColorData", "[", 
       RowBox[{
        RowBox[{"colorscheme", "[", "\[CapitalSigma]", "]"}], ",", 
        "\"\<Panel\>\""}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Front wall corner is (\[Theta]0, \[Sigma]0) = (\>\"", ",", 
      RowBox[{"DegreeText", "[", 
       RowBox[{"\[Theta]forMin", "[", 
        RowBox[{"Tmat", ",", "\[CapitalSigma]"}], "]"}], "]"}], ",", 

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"shape", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Theta]_", ",", "\[Sigma]_", ",", "\[Phi]_"}], "}"}], ",", 
     "MONO", ",", "scale_", ",", "WantColor_"}], "]"}], ":=", 
   RowBox[{"cylinder", "[", "  ", 
    RowBox[{
     RowBox[{
      StyleBox[
       RowBox[{"ZRot", "[", 
        RowBox[{
         RowBox[{"-", "\[Pi]"}], "/", "2"}], "]"}],
       FontColor->RGBColor[1, 0, 0]], 
      StyleBox[".",
       FontColor->RGBColor[1, 0, 0]], 
      RowBox[{"UsHat", "[", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", "\[Sigma]", ",", "\[Phi]"}], "}"}], "]"}]}], 

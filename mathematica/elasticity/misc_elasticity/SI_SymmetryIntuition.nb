Cell["\<\
It is easier to leave the colors off, initially, and just deal with the \
polygons .\
\>", "Subsubsection",
 CellChangeTimes->{{3.922897239820155*^9, 
  3.9228972829588785`*^9}},ExpressionUUID->"9d4221ec-6238-4ac1-9a5f-\
b68f8f4fcc66"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HexPrismPolys", "[", 
    RowBox[{"U_", ",", "center_", ",", "scale_"}], "]"}], ":=", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"center", "+", 
       RowBox[{"scale", " ", 
        RowBox[{"U", ".", "#"}]}]}], "&"}], ",", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ZRot", "[", 
             RowBox[{"i", " ", 
              RowBox[{"\[Pi]", "/", "3"}]}], "]"}], ".", 
            RowBox[{"{", 
             RowBox[{"1", ",", "0", ",", "    ", "1.4"}], "}"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "6"}], "}"}]}], "]"}], ",", "    ", 
         RowBox[{"(*", " ", 
          StyleBox[
           RowBox[{
            RowBox[{"face", " ", "1"}], ",", " ", 
            RowBox[{
             RowBox[{"top", " ", "basal", " ", "if", " ", "U"}], " ", "=", 
             " ", "id"}]}],
           FontColor->RGBColor[1, 0, 0]], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ZRot", "[", 
             RowBox[{"i", " ", 
              RowBox[{"\[Pi]", "/", "3"}]}], "]"}], ".", 
            RowBox[{"{", 
             RowBox[{"1", ",", "0", ",", 
              RowBox[{"-", " ", "1.4"}]}], "}"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "6"}], "}"}]}], "]"}]}], "}"}], ",", "  ", 
       RowBox[{"(*", " ", 
        StyleBox[
         RowBox[{
          RowBox[{"face", " ", "2"}], ",", " ", 
          RowBox[{
           RowBox[{"bottom", " ", "basal", " ", "if", " ", "U"}], " ", "=", 
           " ", "id"}]}],
         FontColor->RGBColor[1, 0, 0]], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"ZRot", "[", 
             RowBox[{"i", " ", 
              RowBox[{"\[Pi]", "/", "3"}]}], "]"}], ".", "#"}], "&"}], "/@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "0", ",", 
              RowBox[{"-", "1.4"}]}], "}"}], ",", 
            RowBox[{
             RowBox[{"ZRot", "[", 
              RowBox[{"\[Pi]", "/", "3"}], "]"}], ".", 
             RowBox[{"{", 
              RowBox[{"1", ",", "0", ",", 
               RowBox[{"-", "1.4"}]}], "}"}]}], ",", 
            RowBox[{
             RowBox[{"ZRot", "[", 
              RowBox[{"\[Pi]", "/", "3"}], "]"}], ".", 
             RowBox[{"{", 
              RowBox[{"1", ",", "0", ",", "1.4"}], "}"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "0", ",", "1.4"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "6"}], "}"}]}], "]"}]}], "]"}], ",", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9182560850197163`*^9, 3.918256130642017*^9}, {

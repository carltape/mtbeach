Cell[CellGroupData[{

Cell[TextData[{
 "Adds the \[Theta]\[Sigma]\[Phi] boundary points implied by mod 2\[Pi].  ",
 StyleBox["set",
  FontSlant->"Italic"],
 " is a set of \[Theta]\[Sigma]\[Phi]triples."
}], "Subsubsection",
 CellChangeTimes->{{3.917027485836136*^9, 3.9170275631591067`*^9}, {
   3.917453753415193*^9, 3.917453778862991*^9}, 3.9175592137429667`*^9, {
   3.939936861493679*^9, 
   3.939936861493679*^9}},ExpressionUUID->"11782b4c-2c29-4708-bfaf-\
d38c83a397c1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ModOnce", "[", "set_", "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"additions", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"set", "[", 
            RowBox[{"[", 
             RowBox[{"n", ",", "1"}], "]"}], "]"}], "==", "0"}], ",", "   ", 
          RowBox[{"additions", "=", 
           RowBox[{"Prepend", "[", 
            RowBox[{"additions", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"2", "\[Pi]"}], ",", 
               RowBox[{"set", "[", 
                RowBox[{"[", 
                 RowBox[{"n", ",", "2"}], "]"}], "]"}], ",", 
               RowBox[{"set", "[", 
                RowBox[{"[", 
                 RowBox[{"n", ",", "3"}], "]"}], "]"}]}], "}"}]}], "]"}]}]}], 
         "]"}], ";", "   ", 
        RowBox[{"(*", " ", 
         StyleBox[
          RowBox[{"the", " ", "\[Theta]", " ", "entry"}],
          FontColor->RGBColor[1, 0, 0]], " ", "*)"}], "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"set", "[", 
            RowBox[{"[", 
             RowBox[{"n", ",", "1"}], "]"}], "]"}], "==", 
           RowBox[{"2", "\[Pi]"}]}], ",", 
          RowBox[{"additions", "=", 
           RowBox[{"Prepend", "[", 
            RowBox[{"additions", ",", 
             RowBox[{"{", "   ", 
              RowBox[{"0", ",", 
               RowBox[{"set", "[", 
                RowBox[{"[", 
                 RowBox[{"n", ",", "2"}], "]"}], "]"}], ",", 
               RowBox[{"set", "[", 
                RowBox[{"[", 
                 RowBox[{"n", ",", "3"}], "]"}], "]"}]}], "}"}]}], "]"}]}]}], 
         "]"}], ";", "\[IndentingNewLine]", "   ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"set", "[", 
            RowBox[{"[", 
             RowBox[{"n", ",", "2"}], "]"}], "]"}], "==", 
           RowBox[{"-", "\[Pi]"}]}], ",", 
          RowBox[{"additions", "=", 
           RowBox[{"Prepend", "[", 
            RowBox[{"additions", ",", 
             RowBox[{"{", " ", 
              RowBox[{
               RowBox[{"set", "[", 
                RowBox[{"[", 
                 RowBox[{"n", ",", "1"}], "]"}], "]"}], ",", "  ", "\[Pi]", 
               ",", 
               RowBox[{"set", "[", 
                RowBox[{"[", 
                 RowBox[{"n", ",", "3"}], "]"}], "]"}]}], "}"}]}], "]"}]}]}], 
         "]"}], ";", "     ", 
        RowBox[{"(*", " ", 
         StyleBox[
          RowBox[{"the", " ", "\[Sigma]", " ", "entry"}],
          FontColor->RGBColor[1, 0, 0]], " ", "*)"}], "\[IndentingNewLine]", 
        "   ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"set", "[", 
            RowBox[{"[", 
             RowBox[{"n", ",", "2"}], "]"}], "]"}], "==", "  ", "\[Pi]"}], 
          ",", 
          RowBox[{"additions", "=", 
           RowBox[{"Prepend", "[", 
            RowBox[{"additions", ",", 
             RowBox[{"{", " ", 
              RowBox[{
               RowBox[{"set", "[", 
                RowBox[{"[", 
                 RowBox[{"n", ",", "1"}], "]"}], "]"}], ",", 
               RowBox[{"-", "\[Pi]"}], ",", 
               RowBox[{"set", "[", 
                RowBox[{"[", 
                 RowBox[{"n", ",", "3"}], "]"}], "]"}]}], "}"}]}], "]"}]}]}], 
         "]"}], ";"}], " ", ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", 
         RowBox[{"Length", "[", "set", "]"}]}], "}"}]}], "]"}], ";", 
     RowBox[{"Union", "[", 
      RowBox[{"set", ",", "additions"}], "]"}]}], ")"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ModComplete", "[", "set_", "]"}], ":=", 
   RowBox[{"ModOnce", "[", 
    RowBox[{"ModOnce", "[", "set", "]"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.916845809525814*^9, 3.9168461884144535`*^9}, {
   3.9168462416158423`*^9, 3.9168462506675177`*^9}, {3.916846424333557*^9, 
   3.916846622655984*^9}, {3.9168466594713717`*^9, 3.916846682906543*^9}, 
   3.9168467269692907`*^9, {3.916846825446949*^9, 3.916846850459467*^9}, {
   3.91684691430707*^9, 3.916846947592724*^9}, {3.9168472841397066`*^9, 
   3.9168473477370076`*^9}, 3.9168475142954893`*^9, {3.9168479161512003`*^9, 
   3.916847963473857*^9}, {3.916848003430281*^9, 3.916848075189379*^9}, {
   3.9168481104182825`*^9, 3.9168481263022313`*^9}, {3.9168481607062883`*^9, 
   3.9168481988490295`*^9}, {3.9168483504065695`*^9, 
   3.9168483550993643`*^9}, {3.916848451431596*^9, 3.9168484772351866`*^9}, 
   3.91684859601009*^9, {3.91684868458313*^9, 3.9168486885874157`*^9}, {
   3.9168490055465145`*^9, 3.916849031128457*^9}, {3.917100177836915*^9, 
   3.917100178763305*^9}},
 CellLabel->
  "In[2444]:=",ExpressionUUID->"fb285a70-6629-4b9b-bd7f-297fec126a36"],


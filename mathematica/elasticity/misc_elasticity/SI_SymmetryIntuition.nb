Cell[CellGroupData[{

Cell["\<\
If the WallPaperThroughMinimizers plot (later) puts the corners in the wall \
at awkward spots, then use the list of Sorted\[Theta]\[Sigma]\[Phi]Minimizers \
to choose a better Prime\[Theta]\[Sigma]\[Phi]Minimizer . The Prime\[Theta]\
\[Sigma]\[Phi]Minimizer gives the corner of the wall. The list of course \
depends on Tmat and \[CapitalSigma].\
\>", "Subsubsection",
 CellChangeTimes->{{4.004541806530089*^9, 
  4.004542012953946*^9}},ExpressionUUID->"39707683-174f-485f-84e0-\
8cccf34b62c6"],


7a90e5bb74ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Theta]\[Phi]pairs", "[", "SetOfRots_", "]"}], ":=", 
  RowBox[{"Union", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Drop", "[", 
      RowBox[{"#", ",", 
       RowBox[{"{", "2", "}"}]}], "]"}], "&"}], "/@", 
    RowBox[{"ModComplete", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Theta]\[Sigma]\[Phi]0to2\[Pi]", "[", "#", "]"}], "&"}], "/@",
       "SetOfRots"}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.917453241695122*^9, 3.9174532602602234`*^9}, {
   3.917453296738387*^9, 3.9174533133317533`*^9}, 3.917453343640111*^9, {

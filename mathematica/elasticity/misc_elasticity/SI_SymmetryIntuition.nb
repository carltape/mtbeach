Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ColorOf\[Theta]\[Sigma]\[Phi]", "[", 
    RowBox[{"{", 
     RowBox[{"\[Theta]_", ",", "\[Sigma]_", ",", "\[Phi]_"}], "}"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"ColorData", "[", "\"\<Rainbow\>\"", "]"}], "[", 
    SqrtBox[
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"Cos", "[", 
         FractionBox["\[Phi]", "2"], "]"}], "2"], 
       SuperscriptBox[
        RowBox[{"Cos", "[", 
         FractionBox[
          RowBox[{"\[Theta]", "+", "\[Sigma]"}], "2"], "]"}], "2"]}]}]], 
    "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[2451]:=",ExpressionUUID->"02ff2502-c019-4b66-880b-fc4f6174b3e2"]
}, Open  ]],


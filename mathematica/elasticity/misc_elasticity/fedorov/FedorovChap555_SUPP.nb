   3.938075849078729*^9}, {3.9388130541136913`*^9, 3.9388131246548934`*^9}, 
   3.993060830560731*^9, 3.9930828861587915`*^9, {3.99322668024337*^9, 
   3.993226682721836*^9}, 3.993310291661007*^9, {3.9933105057721825`*^9, 
   3.9933105536895957`*^9}, 
   3.9935147180662737`*^9},ExpressionUUID->"f853e13b-c76b-4128-b6ce-\
bd1169c62054"],

Cell[TextData[{
 "Lbold[c] (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox[
       StyleBox["L",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       RowBox[{"c", " "}]], "in", " ", "the", " ", "pdf"}], ")"}], " ", "is", 
    " ", "the", " ", "elastic", " ", "map", " ", "determined", " ", "by", " ",
     "c"}], TraditionalForm]],ExpressionUUID->
  "00110dac-5f59-44d0-9216-635186503dd4"],
 ", where c[{i,j,k,l}]= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "iklm"], TraditionalForm]],ExpressionUUID->
  "9529dc0d-1601-464a-9985-548d537fe982"],
 " is defined for i,j,k,l=1,2,3. \nThe usual three symmetries are \
incorporated."
}], "Subsubsection",
 CellChangeTimes->{{3.93803798880681*^9, 3.938038067371353*^9}, {
   3.938038132167988*^9, 3.9380382167129774`*^9}, {3.9383900104824524`*^9, 

Cell[CellGroupData[{

Cell[TextData[{
 "Eq (26.33) of Fedorov. \n",
 StyleBox["In some applications, k does not work as a summation index, due to \
its appearance in BlankSlate; hence kk here.",
  FontSlant->"Italic"],
 "\nNote that Canonical is included in cClosestFed and aClosestFed.\nDo not \
somehow confuse c in cClosestFed with c referring to elastic constants."
}], "Subsubsection",

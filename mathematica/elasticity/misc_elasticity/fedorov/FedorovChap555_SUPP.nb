Cell[CellGroupData[{

Cell["\<\
This file shows that Eqs (26.31) and (26.33) of Fedorov are consistent with \
Eq (84a) of TT2024. 
But can Fedorov justify using Voigt matrices and inner products?\
\>", "Subsection",
 CellChangeTimes->{{3.9351619017548265`*^9, 3.9351619078640227`*^9}, {
   3.935162013407283*^9, 3.9351620264561405`*^9}, {3.9351620639136186`*^9, 

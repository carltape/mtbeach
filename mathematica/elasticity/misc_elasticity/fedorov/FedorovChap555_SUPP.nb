Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["L",
     FontWeight->"Bold",
     FontSlant->"Plain"], "c"], TraditionalForm]],ExpressionUUID->
  "913a502d-8be9-499a-8885-1edf97b9a8de"],
 " be the elastic map determined by the elastic constants c[{i, k, l, m}] = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "iklm"], TraditionalForm]],ExpressionUUID->
  "43a97941-1872-40d0-b283-4b2e410f8b2b"],
 " (i, k, l, m = 1, 2, 3).\nThe closest ISO map ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["K",
      FontWeight->"Bold",
      FontSlant->"Plain"], "ISO"], "(", 
    StyleBox[
     SubscriptBox[
      StyleBox["L",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["c",
       FontWeight->"Plain"]],
     FontWeight->"Bold",
     FontSlant->"Plain"], ")"}], TraditionalForm]],ExpressionUUID->
  "d1988cb3-7fc8-40bf-9322-2bbe7e86099e"],
 " to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["L",
     FontWeight->"Bold",
     FontSlant->"Plain"], "c"], TraditionalForm]],ExpressionUUID->
  "35631f08-7f48-4020-9c21-0c7be8195401"],
 " is then ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["L",
     FontWeight->"Bold",
     FontSlant->"Plain"], "c0"], TraditionalForm]],ExpressionUUID->
  "cfea40a9-2c41-4e85-9492-3349c8d33051"],
 ", for some ",
 Cell[BoxData[
  FormBox["c0", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c6852fb7-d947-40a3-b704-b4a5af12ff2c"],
 ".\n(I have replaced Fedorov\[CloseCurlyQuote]s notation \[Lambda]0[{i, k, \
l, m} with c0[{i, k, l, m}], the latter being consistent with Eq 8.1).\nBoth \
c and c0 are ",
 StyleBox["functions",
  FontSlant->"Italic"],
 "; c[{i, k, l, m}] = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "iklm"], TraditionalForm]],ExpressionUUID->
  "9d250cfe-3fcd-4e66-b4b4-5ff207346897"],
 " (i, k, l, m = 1, 2, 3) are the elastic constants for the given elastic map \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["L",
     FontWeight->"Bold",
     FontSlant->"Plain"], "c"], TraditionalForm]],ExpressionUUID->
  "af82b6d2-32a1-4654-8cb7-0d9e7833f39b"],
 ", and c0[{i, k, l, m}, c] are the elastic constants for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["K",
      FontWeight->"Bold",
      FontSlant->"Plain"], "ISO"], "(", 
    StyleBox[
     SubscriptBox[
      StyleBox["L",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["c",
       FontWeight->"Plain"]],
     FontWeight->"Bold",
     FontSlant->"Plain"], ")"}], TraditionalForm]],ExpressionUUID->
  "eb08066a-772f-4bc8-8112-8350ac84e0d0"],
 ".\nFor each c you have a function c0[#, c] &, just as for each ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["L",
     FontWeight->"Bold",
     FontSlant->"Plain"], "c"], TraditionalForm]],ExpressionUUID->
  "16e6f1a5-ec0e-433b-bbea-b009a67aafbe"],
 StyleBox[" ",
  FontWeight->"Bold"],
 "you have a ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["K",
      FontWeight->"Bold",
      FontSlant->"Plain"], "ISO"], "(", 
    StyleBox[
     SubscriptBox[
      StyleBox["L",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["c",
       FontWeight->"Plain"]],
     FontWeight->"Bold",
     FontSlant->"Plain"], ")"}], TraditionalForm]],ExpressionUUID->
  "65f841d4-54b0-4ee9-a88f-7bafabcc1c62"],
 "."
}], "Subsubsection",

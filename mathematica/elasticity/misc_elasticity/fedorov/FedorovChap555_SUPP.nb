Cell[CellGroupData[{

Cell[TextData[{
 "We are done, but note that for us, finding ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"[", 
     RowBox[{
      SubscriptBox[
       StyleBox["K",
        FontWeight->"Bold",
        FontSlant->"Plain"], "ISO"], "(", 
      StyleBox[
       SubscriptBox[
        StyleBox["L",
         FontWeight->"Bold",
         FontSlant->"Plain"], 
        StyleBox["c",
         FontWeight->"Plain"]],
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], "]"}], 
    "\[DoubleStruckCapitalB]\[DoubleStruckCapitalB]"], TraditionalForm]],
  ExpressionUUID->"a577a9e6-078d-4687-b985-672589515e45"],
 " from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"[", 
     SubscriptBox[
      StyleBox["L",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["c",
       FontWeight->"Plain"]], "]"}], 
    "\[DoubleStruckCapitalB]\[DoubleStruckCapitalB]"], TraditionalForm]],
  ExpressionUUID->"02dc1fca-044a-40db-a45f-2819d23ddbd6"],
 " is easy, from Eq (84a) of TT2024. You average the five pink entries to get \
the first five diagonal entries of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"[", 
     RowBox[{
      SubscriptBox[
       StyleBox["K",
        FontWeight->"Bold",
        FontSlant->"Plain"], "ISO"], "(", 
      StyleBox[
       SubscriptBox[
        StyleBox["L",
         FontWeight->"Bold",
         FontSlant->"Plain"], 
        StyleBox["c",
         FontWeight->"Plain"]],
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], "]"}], 
    "\[DoubleStruckCapitalB]\[DoubleStruckCapitalB]"], TraditionalForm]],
  ExpressionUUID->"939465af-3d14-420c-a75c-340cdd055b38"],
 ", and the green entry is the sixth diagonal entry of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"[", 
     RowBox[{
      SubscriptBox[
       StyleBox["K",
        FontWeight->"Bold",
        FontSlant->"Plain"], "ISO"], "(", 
      StyleBox[
       SubscriptBox[
        StyleBox["L",
         FontWeight->"Bold",
         FontSlant->"Plain"], 
        StyleBox["c",
         FontWeight->"Plain"]],
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], "]"}], 
    "\[DoubleStruckCapitalB]\[DoubleStruckCapitalB]"], TraditionalForm]],
  ExpressionUUID->"4bb2e519-292c-4f41-8edf-a32ea603df4f"],
 "."
}], "Subsubsection",
 CellChangeTimes->CompressedData["

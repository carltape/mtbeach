Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "cIsoFedorov", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kd", "=", "KroneckerDelta"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"cIsoFedorov", "[", 
     RowBox[{"a_", ",", "c_", ",", "iklm_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"c", " ", 
      RowBox[{"kd", "[", 
       RowBox[{
        RowBox[{"iklm", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"iklm", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "]"}], 
      RowBox[{"kd", "[", 
       RowBox[{
        RowBox[{"iklm", "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", 
        RowBox[{"iklm", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], "]"}]}], "+", 
     RowBox[{"a", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"kd", "[", 
          RowBox[{
           RowBox[{"iklm", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"iklm", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "]"}], 
         RowBox[{"kd", "[", 
          RowBox[{
           RowBox[{"iklm", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", 
           RowBox[{"iklm", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"kd", "[", 
          RowBox[{
           RowBox[{"iklm", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"iklm", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], "]"}], 
         RowBox[{"kd", "[", 
          RowBox[{
           RowBox[{"iklm", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", 
           RowBox[{"iklm", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}]}], ")"}]}]}]}], ";"}], 
  " ", 
  RowBox[{"(*", " ", 
   StyleBox[
    RowBox[{
     RowBox[{"Fedorov", "'"}], "s", " ", "Eq", " ", 
     RowBox[{"(", "8.1", ")"}]}],
    FontColor->RGBColor[1, 0, 0]], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<VoigtMatrixofISOfromFedorov = \>\"", ",", 
    RowBox[{"MatrixForm", "[", 
     RowBox[{"VoigtMatrixOFc", "[", 
      RowBox[{
       RowBox[{"cIsoFedorov", "[", 
        RowBox[{"a", ",", "c", ",", "#"}], "]"}], "&"}], "]"}], "]"}], ",", 
    "\"\< = \>\"", ",", 
    RowBox[{"MatrixForm", "[", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"VoigtMatrixOFc", "[", 
        RowBox[{
         RowBox[{"cIsoFedorov", "[", 
          RowBox[{"a", ",", "c", ",", "#"}], "]"}], "&"}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"c", "->", 
          SubscriptBox["c", "12"]}], ",", 
         RowBox[{"a", "->", 
          FractionBox[
           RowBox[{
            SubscriptBox["c", "11"], "-", 
            SubscriptBox["c", "12"]}], "2"]}]}], "}"}]}], "]"}], "]"}]}], 
   "]"}], ";"}]}], "Input",

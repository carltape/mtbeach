Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"cClosestFed", "[", "c_", "]"}], ":=", 
   RowBox[{
    FractionBox["1", "15"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"kk", "=", "1"}], "3"], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"l", "=", "1"}], "3"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", 
         RowBox[{"c", "[", 
          RowBox[{"Canonical", "[", 
           RowBox[{"{", 
            RowBox[{"l", ",", "l", ",", "kk", ",", "kk"}], "}"}], "]"}], 
          "]"}]}], "-", 
        RowBox[{"c", "[", 
         RowBox[{"Canonical", "[", 
          RowBox[{"{", 
           RowBox[{"l", ",", "kk", ",", "l", ",", "kk"}], "}"}], "]"}], 
         "]"}]}], ")"}]}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"aClosestFed", "[", "c_", "]"}], ":=", 
   RowBox[{
    FractionBox["1", "30"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"kk", "=", "1"}], "3"], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"l", "=", "1"}], "3"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", 
         RowBox[{"c", "[", 
          RowBox[{"Canonical", "[", 
           RowBox[{"{", 
            RowBox[{"l", ",", "kk", ",", "l", ",", "kk"}], "}"}], "]"}], 
          "]"}]}], "-", 
        RowBox[{"c", "[", 
         RowBox[{"Canonical", "[", 
          RowBox[{"{", 
           RowBox[{"l", ",", "l", ",", "kk", ",", "kk"}], "}"}], "]"}], 
         "]"}]}], ")"}]}]}]}]}], ";"}]}], "Input",

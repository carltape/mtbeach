Cell[BoxData[
 RowBox[{
  RowBox[{"ShowCosetsAndRefMats", "[", "\[CapitalSigma]_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "RefMats", ",", "EqClassesOfRefMatPositions", ",", "partitionOFbbG"}], 
     "}"}], ",", " ", 
    RowBox[{"(*", " ", 
     StyleBox[
      RowBox[{"used", " ", "to", " ", "be", " ", "ShowGroups"}],
      FontColor->RGBColor[1, 0, 0]], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"partitionOFbbG", "=", 
      RowBox[{"partition", "[", 
       RowBox[{
        RowBox[{"bbG", "[", "\[CapitalSigma]", "]"}], ",", 
        RowBox[{"rr", "[", "\[CapitalSigma]", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<\[CapitalSigma] = \>\"", ",", "\[CapitalSigma]"}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<cosets of \!\(\*SubscriptBox[\(\[DoubleStruckCapitalU]\), \(\
\[CapitalSigma]\)]\) in \!\(\*SubscriptBox[\(\[DoubleStruckCapitalG]\), \(\
\[CapitalSigma]\)]\) are \>\"", ",", 
       RowBox[{"ColumnForm", "[", 
        RowBox[{"Map", "[", 
         RowBox[{"MatrixForm", ",", "partitionOFbbG", ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], "]"}], ",", "\"\< = \>\"", ",", 
       RowBox[{"ColumnForm", "[", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"TableForm", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<   \>\"", ",", 
              RowBox[{"BarFormText", "[", "#", "]"}], ",", "\"\<   \>\""}], 
             "}"}], "]"}], "&"}], ",", "partitionOFbbG", ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<RefMat for \>\"", ",", 
          RowBox[{"SequenceForm", "[", 
           RowBox[{
            RowBox[{"BarFormText", "/@", 
             RowBox[{"partitionOFbbG", "[", 
              RowBox[{"[", "jj", "]"}], "]"}]}], ",", "\"\< is \>\"", ",", 
            RowBox[{"MatrixForm", "[", 
             RowBox[{"RefMat", "[", 
              RowBox[{
               RowBox[{"partitionOFbbG", "[", 
                RowBox[{"[", 
                 RowBox[{"jj", ",", "1"}], "]"}], "]"}], ",", 
               "\[CapitalSigma]"}], "]"}], "]"}]}], "]"}]}], "]"}], ";"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"jj", ",", 
         RowBox[{"Length", "[", "partitionOFbbG", "]"}]}], "}"}]}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"WantCarl", "==", "\"\<WantCarl\>\""}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"RefMats", "=", 
         RowBox[{"Simplify", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"RefMat", "[", 
             RowBox[{"#", ",", "\[CapitalSigma]"}], "]"}], "&"}], "/@", 
           RowBox[{"bbG", "[", "\[CapitalSigma]", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"EqClassesOfRefMatPositions", "=", 
         RowBox[{"GatherBy", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"Length", "[", "RefMats", "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"RefMats", "[", 
             RowBox[{"[", "#", "]"}], "]"}], "&"}]}], "]"}]}], ";", "  ", 
        RowBox[{"(*", " ", 
         StyleBox[
          RowBox[{"used", " ", "to", " ", "be", " ", "groups"}],
          FontColor->RGBColor[1, 0, 0]], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "EqClassesOfRefMatPositions", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"Length", "[", "EqClassesOfRefMatPositions", "]"}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"EqClassesOfRefMatPositions", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{"MatrixForm", "[", 
               RowBox[{"RefMats", "[", 
                RowBox[{"[", 
                 RowBox[{"EqClassesOfRefMatPositions", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "]"}], 
               "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"Length", "[", "EqClassesOfRefMatPositions", "]"}]}], 

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"TmatForSigma", "[", "\[CapitalSigma]_", "]"}], ":=", 
    RowBox[{"Switch", "[", 
     RowBox[{
     "\[CapitalSigma]", ",", "ISO", ",", "TmatForISO", ",", "XISO", ",", 
      "TmatForXISO", ",", "TET", ",", "TmatForTET", ",", "ORTH", ",", 
      "TmatForORTH", ",", "MONO", ",", "TmatForMONO", ",", "TRIG", ",", 
      "TmatForTRIG", ",", "CUBE", ",", "TmatForCUBE"}], "]"}]}], ";", 
   RowBox[{
    RowBox[{"RefMat", "[", 
     RowBox[{"V_", ",", "\[CapitalSigma]_"}], "]"}], ":=", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"MatrixUbar", "[", "V", "]"}], ".", 
      RowBox[{"TmatForSigma", "[", "\[CapitalSigma]", "]"}], ".", 
      RowBox[{"Transpose", "[", 
       RowBox[{"MatrixUbar", "[", "V", "]"}], "]"}]}], "]"}]}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   StyleBox[
    RowBox[{"used", " ", "to", " ", "be", " ", "HatT2"}],
    FontColor->RGBColor[1, 0, 0]], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rr", "[", "\[CapitalSigma]_", "]"}], "[", 
    RowBox[{"U1_", ",", "U2_"}], "]"}], ":=", 
   RowBox[{"MemberQ", "[", 
    RowBox[{
     RowBox[{"RefGp", "[", "\[CapitalSigma]", "]"}], ",", 
     RowBox[{
      RowBox[{"Transpose", "[", "U1", "]"}], ".", "U2"}]}], "]"}]}], 
  ";"}]}], "Input",

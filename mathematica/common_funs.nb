  RowBox[{
   RowBox[{"ProjToVSigOfU", "[", 
    RowBox[{
     TagBox[
      RowBox[{"(", "\[NoBreak]", GridBox[{
         {"a_", "g_", "m_", "q_", "t_", "v_"},
         {"gdum_", "b_", "h_", "n_", "r_", "u_"},
         {"mdum_", "hdum_", "c_", "i_", "o_", "s_"},
         {"qdum_", "ndum_", "idum_", "d_", "j_", "p_"},
         {"tdum_", "rdum_", "odum_", "jdum_", "e_", "k_"},
         {"vdum_", "udum_", "sdum_", "pdum_", "kdum_", "f_"}
        },
        GridBoxAlignment->{

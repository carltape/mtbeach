Cell[TextData[{
 "You are getting contours of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", "\[CapitalSigma]", 
    StyleBox["T",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "23bef2d5-9c03-4db3-9900-686dd3b593f8"],
 " with contours determined by contours[Tmat00, \[CapitalSigma]], but the \
coloring is determined by colorscheme[\[CapitalSigma]]. \nThe reason for \
Tmat00 is to have multiple plots but all with consistent coloring."
}], "Subsubsection",
 CellChangeTimes->{{3.9223050357196264`*^9, 3.922305056399501*^9}, {

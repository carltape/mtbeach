  RowBox[{
   RowBox[{
    RowBox[{"UbarLT", "[", 
     RowBox[{"E_", ",", "U_"}], "]"}], ":=", 
    RowBox[{"U", ".", "E", ".", 
     RowBox[{"Transpose", "[", "U", "]"}]}]}], ";"}], "    ", 
  RowBox[{"(*", " ", 
   StyleBox[
    RowBox[{
     RowBox[{"the", " ", "linear", " ", "transformation"}], ",", " ", 
     RowBox[{"not", " ", "the", " ", "matrix"}]}],
    FontColor->RGBColor[1, 0, 0]], " ", "*)"}]}], "\[IndentingNewLine]", 

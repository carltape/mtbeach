   3.9200644684970226`*^9, 3.920064503391965*^9}, {3.9210758081913023`*^9, 
   3.9210758153678017`*^9}, {3.925600288526909*^9, 3.9256002903208003`*^9}, {
   3.9256003209255095`*^9, 3.925600323326578*^9}, {3.9256004478179536`*^9, 

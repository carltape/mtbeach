   RowBox[{"ProjToVSigOfU", "[", 
    RowBox[{"Tmat", ",", 
     RowBox[{"UswapVandKnoQualify", "[", "vpt", "]"}], ",", 
     "\[CapitalSigma]"}], "]"}]}], ";"}]], "Input",

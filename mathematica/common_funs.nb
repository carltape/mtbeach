          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ".", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], " ", "&"}], ",", 
           RowBox[{"CartesianProduct", "[", 
            RowBox[{"{", 
             RowBox[{"a", ",", "a"}], "}"}], "]"}]}], "]"}], "]"}]}], "]"}], 
      ",", 
      RowBox[{
       RowBox[{"FullSimplify", "[", 
        RowBox[{"#1", "==", "#2"}], "]"}], "&"}]}], "]"}]}], " ", ";"}], "  ", 
  RowBox[{"(*", " ", 
   StyleBox[
    RowBox[{
     RowBox[{

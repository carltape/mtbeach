 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"AllProducts", "[", "a_", "]"}], ":=", 
    RowBox[{"DeleteDuplicates", "[", 
     RowBox[{
      RowBox[{"Union", "[", 
       RowBox[{"a", ",", 
        RowBox[{"Simplify", "[", 

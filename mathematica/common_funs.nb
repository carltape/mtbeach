   3.9671602994065275`*^9}},ExpressionUUID->"53077a48-52a7-4108-adf3-\
3a8020e046a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["cPrimeMusgrave",
      FontColor->GrayLevel[0]], "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"m_", ",", "n_", ",", "r_", ",", "s_"}], "}"}], ",", "c_", ",",
       "A_"}], "]"}], ":=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"m", ",", "i"}], "]"}], "]"}], 
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"n", ",", "j"}], "]"}], "]"}], 
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"r", ",", "k"}], "]"}], "]"}], 
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"s", ",", "l"}], "]"}], "]"}], 
       RowBox[{"c", "[", 
        RowBox[{"Canonical", "[", 
         RowBox[{"{", 
          RowBox[{"i", ",", "j", ",", "k", ",", "l"}], "}"}], "]"}], "]"}]}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "3"}], "}"}]}], "]"}]}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   StyleBox[
    RowBox[{
     RowBox[{"Musgrave", "'"}], "s", " ", "Eq", " ", 
     RowBox[{"(", 
      RowBox[{"3.12", ".2", "a"}], ")"}], "but", " ", "I", " ", "have", " ", 
     "explicitly", " ", "added", " ", "the", " ", 
     RowBox[{"Canonical", "."}]}],
    FontColor->RGBColor[1, 0, 0]], 
   StyleBox[" ",
    FontColor->RGBColor[1, 0, 0]], "*)"}]}]], "Input",
 CellChangeTimes->{{3.9645340725967045`*^9, 3.9645342270652227`*^9}, {

}, Open  ]],

Cell[TextData[{
 "Just brute force for MaxAlphaSubSigma. Good enough for getting contours and \
MaxForScaling.  And Mathematica has trouble with NMaximize.\nI had to change \
MinAlphaSubSigma to \[Beta]T, so it will take a while. ",
 StyleBox["Probably set nRuns = 1",
  FontColor->RGBColor[1, 0, 0]],
 "."
}], "Subsubsection",
 CellChangeTimes->{{3.9175406141633153`*^9, 3.917540676334525*^9}, {
   3.917550569330822*^9, 3.917550593061283*^9}, 3.927156631217106*^9, {
   3.9446680183046436`*^9, 3.9446680313662233`*^9}, {3.9446681003595753`*^9, 
   3.9446681594834146`*^9}},ExpressionUUID->"0a76e4fe-510b-4adf-9b7d-\
a86e5b66ff4d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"AlphaSubSigmaTable", "[", 
    RowBox[{"Tmat_", ",", "\[CapitalSigma]_"}], "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"AlphaOfU", "[", 
      RowBox[{"Tmat", ",", "RandomRotation", ",", "\[CapitalSigma]"}], "]"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"kk", ",", "1", ",", "5000"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "MaxAlphaSubSigma", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MaxAlphaSubSigma", "[", 
    RowBox[{"Tmat_", ",", "\[CapitalSigma]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"MaxAlphaSubSigma", "[", 
     RowBox[{"Tmat", ",", "\[CapitalSigma]"}], "]"}], "=", 
    RowBox[{
     RowBox[{"Max", "[", 
      RowBox[{"AlphaSubSigmaTable", "[", 
       RowBox[{"Tmat", ",", "\[CapitalSigma]"}], "]"}], "]"}], "/", 
     "Degree"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MinAlphaSubSigma", "[", 
    RowBox[{"Tmat_", ",", "\[CapitalSigma]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Beta]T", "[", 
     RowBox[{"Tmat", ",", "\[CapitalSigma]"}], "]"}], "/", "Degree"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.920489694976289*^9, 3.9204897837391653`*^9}, {
   3.9204898599803905`*^9, 3.9204898611584597`*^9}, {3.9204899155729604`*^9, 
   3.9204899230044775`*^9}, {3.92048998498238*^9, 3.9204900097897415`*^9}, {
   3.9204900767862787`*^9, 3.920490077194627*^9}, {3.920490210213154*^9, 
   3.920490306758027*^9}, {3.9204904070174885`*^9, 3.920490408240369*^9}, {
   3.920509051148344*^9, 3.920509051947177*^9}, {3.9205092295481925`*^9, 
   3.9205092323314686`*^9}, {3.92599837978135*^9, 3.9259983855106764`*^9}, {
   3.9259984532482243`*^9, 3.925998466767654*^9}, {3.925999869605427*^9, 
   3.925999891069739*^9}, {3.9260021737055583`*^9, 3.926002184889187*^9}, 
   3.926002231468638*^9, {3.926002804397115*^9, 3.9260028055624466`*^9}, 
   3.926687374941324*^9, 3.9271566059651947`*^9, {3.9446213924771795`*^9, 
   3.9446213930579023`*^9}, {3.9446216299808507`*^9, 3.944621658390427*^9}, {
   3.9446681740769815`*^9, 3.944668175952277*^9}, {3.951787075961138*^9, 
   3.9517870905529013`*^9}, {3.951834193723096*^9, 3.951834207535206*^9}},
 CellLabel->

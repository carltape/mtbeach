Cell[BoxData[{
 RowBox[{"CoordsOf3x3matrixWRTbasis", "[", 
  RowBox[{
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {"m1", "m6", "m5"},
      {"m6", "m2", "m4"},
      {"m5", "m4", "m3"}
     }], "\[NoBreak]", ")"}], ",", "basisBB"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {
       FractionBox[
        RowBox[{"a", "+", "b", "+", "c", "+", "d", "+", "e"}], "5"], "0", "0",
        "0", "0", "0"},
      {"0", 
       FractionBox[
        RowBox[{"a", "+", "b", "+", "c", "+", "d", "+", "e"}], "5"], "0", "0",
        "0", "0"},
      {"0", "0", 
       FractionBox[
        RowBox[{"a", "+", "b", "+", "c", "+", "d", "+", "e"}], "5"], "0", "0",
        "0"},
      {"0", "0", "0", 
       FractionBox[
        RowBox[{"a", "+", "b", "+", "c", "+", "d", "+", "e"}], "5"], "0", "0"},
      {"0", "0", "0", "0", 
       FractionBox[
        RowBox[{"a", "+", "b", "+", "c", "+", "d", "+", "e"}], "5"], "0"},
      {"0", "0", "0", "0", "0", "f"}
     }], "\[NoBreak]", ")"}], ".", 
   RowBox[{"CoordsOf3x3matrixWRTbasis", "[", 
    RowBox[{
     RowBox[{"(", "\[NoBreak]", GridBox[{
        {"m1", "m6", "m5"},
        {"m6", "m2", "m4"},
        {"m5", "m4", "m3"}
       }], "\[NoBreak]", ")"}], ",", "basisBB"}], "]"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MatrixForm", "[", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Matrix3x3fromBasisCoords", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", "\[NoBreak]", GridBox[{
          {
           FractionBox[
            RowBox[{"a", "+", "b", "+", "c", "+", "d", "+", "e"}], "5"], "0", 
           "0", "0", "0", "0"},
          {"0", 
           FractionBox[
            RowBox[{"a", "+", "b", "+", "c", "+", "d", "+", "e"}], "5"], "0", 
           "0", "0", "0"},
          {"0", "0", 
           FractionBox[
            RowBox[{"a", "+", "b", "+", "c", "+", "d", "+", "e"}], "5"], "0", 
           "0", "0"},
          {"0", "0", "0", 

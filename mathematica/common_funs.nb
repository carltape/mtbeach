Cell[TextData[{
 "The function Canonical applies the usual three symmetries of elastic \
constants: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "ijkl"], " ", "=", " "}], TraditionalForm]],
  ExpressionUUID->"cbee98e7-69df-478c-b386-f92fef9f2a81"],

       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], "]"}]}], "<", 
      RowBox[{
      ".000001", " ", "Feb", " ", "2024", " ", "to", " ", "accommodate", " ", 

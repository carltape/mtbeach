Cell[TextData[{
 "Newer versions are in BC_BrowaeysChevrotNotes.nb and \
SI_SymmetryIntuition.nb.\nThe above shows containments among the reference \
groups ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[DoubleStruckCapitalU]", "\[CapitalSigma]"], 
   TraditionalForm]],ExpressionUUID->"e0dcd4c8-c924-4913-9c62-1a0817e759ec"],
 ". \nThey should be obvious from Table 2 of TT2024. Also from Fig 7b of \
Gupta et al.\nBelow, upper left, is the same but for \[CapitalSigma] \
subgroups ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[DoubleStruckCapitalV]", "\[CapitalSigma]"], "(", "U", 
    ")"}], TraditionalForm]],ExpressionUUID->
  "6ee2f6e2-0634-4da5-b5d5-7670cc704791"],
 " all with the same ",
 StyleBox["U",
  FontSlant->"Italic"],
 ".\nBelow, upper right, shows containments for \[CapitalSigma] subspaces ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ScriptCapitalV]", "\[CapitalSigma]"], "(", "U", ")"}], 
   TraditionalForm]],ExpressionUUID->"301db568-9a73-4ce6-966c-082b22e6e6ce"],
 " all with the same ",
 StyleBox["U.\n",
  FontSlant->"Italic"],
 "Below, at lower left, the nodes are symmetry classes and the arrows show \
directions of increasing symmetry. See the relation  \[Precedes]  of Eq 19a \
of TT2022.\nBelow, lower right, shows containments among the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ScriptCapitalT]", "\[CapitalSigma]"], "."}], 
   TraditionalForm]],ExpressionUUID->"75796d1b-6a89-4500-aa47-674b590419bc"],
 " From the lower row you see that symmetry class ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalSigma]", "2"], " "}], TraditionalForm]],
  ExpressionUUID->"07ed0335-f446-4959-8b5c-05c83166bab9"],
 "has higher symmetry than ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalSigma]", "1"], TraditionalForm]],ExpressionUUID->
  "1769477f-4871-4909-bb1c-9d9a9c775a81"],
 " if and only if ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalT]", "2"], TraditionalForm]],ExpressionUUID->
  "4c153fcc-f5b0-48e5-b0f1-ee782eb7db64"],
 " \[Subset] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ScriptCapitalT]", "1"], "."}], TraditionalForm]],
  ExpressionUUID->"81a877c1-c810-49b8-9d22-bb4e351baaa5"]
}], "Subsubsection",
 CellChangeTimes->{{3.9468291512530613`*^9, 3.946829216525178*^9}, {
  3.9468292600759687`*^9, 3.9468292710415382`*^9}, {3.946829478816996*^9, 

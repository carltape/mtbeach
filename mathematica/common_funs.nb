Cell[BoxData[{
 RowBox[{
  RowBox[{"A", "=", "RandomRotation"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ForSampleDefinitions", "=", 
  RowBox[{"Select", "[", 

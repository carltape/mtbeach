Cell["Fedorov' s \[CapitalLambda] tensor :", "Subsection",
 CellChangeTimes->{{3.8255460743307104`*^9, 3.825546149037276*^9}, {
   3.8255462833905034`*^9, 3.8255462834095063`*^9}, 

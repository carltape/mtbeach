          "\[IndentingNewLine]", 
          RowBox[{"Arrow3D", "[", 
           RowBox[{
            RowBox[{"c", "+", 
             RowBox[{"u", ".", 
              RowBox[{"{", 
               RowBox[{"lengthAxis", ",", "0", ",", "0"}], "}"}]}]}], ",", 
            RowBox[{"u", ".", 
             RowBox[{"{", 
              RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ",", "ArrowScale"}],
            "]"}]}], "}"}]}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{"t2", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 

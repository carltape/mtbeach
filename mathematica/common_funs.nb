          RowBox[{"BarForm", "[", 
           RowBox[{
            RowBox[{"RotAxisForNfoldU", "[", "U", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"BarForm", "[", 
           RowBox[{
            RowBox[{"RotAxisForNfoldU", "[", "U", "]"}], "[", 
            RowBox[{"[", "3", "]"}], "]"}], "]"}]}], "]"}], ",", 
        RowBox[{"2", 
         RowBox[{"\[Pi]", "/", 
          RowBox[{"FullSimplify", "[", 
           RowBox[{"RotationAngle", "[", "U", "]"}], "]"}]}]}]}], "]"}], "//",
       "DisplayForm"}]}], "]"}]}], ";"}]}], "Input",

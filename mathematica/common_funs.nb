Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Phi]1", "[", 
    RowBox[{"a_", ",", "c_", ",", "e_", ",", "k_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"ArcTan", "[", "  ", 
     RowBox[{
      RowBox[{
       SqrtBox["3"], " ", 
       SqrtBox[
        RowBox[{
         RowBox[{"2", " ", 
          SuperscriptBox["a", "2"]}], "-", 
         SuperscriptBox["c", "2"], "-", 
         RowBox[{"4", " ", "a", " ", "e"}], "+", 
         RowBox[{"2", " ", "c", " ", "e"}], "+", 
         SuperscriptBox["e", "2"], "-", 
         RowBox[{"2", " ", 
          SuperscriptBox["k", "2"]}]}]]}], ",", " ", 
      SqrtBox[
       RowBox[{
        RowBox[{"10", " ", 
         SuperscriptBox["a", "2"]}], "+", 
        RowBox[{"4", " ", 
         SuperscriptBox["c", "2"]}], "-", 
        RowBox[{"4", " ", "a", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "c"}], "+", 
           RowBox[{"3", " ", "e"}]}], ")"}]}], "+", 
        RowBox[{"6", " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["e", "2"], "+", 
           SuperscriptBox["k", "2"]}], ")"}]}]}]]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xyOF\[Phi]", "[", "\[Phi]_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sin", "[", "\[Phi]", "]"}], ",", 
     RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{

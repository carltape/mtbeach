Cell["Change of spatial coordinates.", "Section",
 CellChangeTimes->{{3.9653912084265156`*^9, 
  3.9653912340211864`*^9}},ExpressionUUID->"d94c4a6a-dd08-4ebc-9ebb-\
b046ff2316d0"],

Cell[TextData[{
 "We are given elastic constants c[{i,j,k,l}] from the literature. They \
depend on the underlying xyz spatial coordinates of the author. \nWe want the \
corresponding Voigt matrix for our spatial coordinates. Then it can always be \
changed to a Tmat if desired.\nSay the coordinate change from the author\
\[CloseCurlyQuote]s spatial coordinates to ours is the rotation matrix U = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["u", "ij"]}], TraditionalForm]],ExpressionUUID->
  "8580e422-ae97-4ba3-b9cf-9cb232d58774"],
 "), (or so",
 "me",
 StyleBox["times",
  FontWeight->"Normal"],
 " ",
 StyleBox["A",
  FontSlant->"Italic"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["a", "ij"]}], TraditionalForm]],ExpressionUUID->
  "7f58f667-31cc-48ad-afa1-1c3ecd10a449"],
 "), to be consistent with Musgrave\[CloseCurlyQuote]s notation).\nWe have \
(at least) three solutions:\n\nMethod 1.  Use Musgrave\[CloseCurlyQuote]s Eq \
(3.12.2a)."
}], "Subsubsection",
 CellChangeTimes->{{3.9653915522195454`*^9, 3.9653920104073544`*^9}, {
   3.965392132196368*^9, 3.9653921385423064`*^9}, 3.9653921721095915`*^9, {
   3.965962266715104*^9, 3.9659623356768107`*^9}, {3.96596265951525*^9, 
   3.965962666437815*^9}, {3.9659660295887446`*^9, 3.9659662288082457`*^9}, {
   3.9659662710819855`*^9, 3.9659662733754797`*^9}, {3.965966337533341*^9, 
   3.965966390884163*^9}, {3.9659665418906345`*^9, 3.965966561398491*^9}, {
   3.965966609586381*^9, 3.965966659803765*^9}, {3.9659667056890955`*^9, 
   3.9659667732839155`*^9}, {3.965966847772735*^9, 3.965966889086811*^9}, {
   3.9660063326400223`*^9, 3.966006385600108*^9}, {3.966093398624976*^9, 
   3.9660934686018248`*^9}, {3.9671475672574167`*^9, 
   3.9671476205318823`*^9}, {3.9671476518030806`*^9, 
   3.9671477259296284`*^9}, {3.967147849755635*^9, 3.9671478792195573`*^9}, {

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MONOmatrix", "[", 
    RowBox[{
    "a_", ",", "b_", ",", "\[Lambda]3_", ",", "\[Lambda]4_", ",", 
     "\[Lambda]5_", ",", "\[Lambda]6_", ",", "U2_", ",", "U4_"}], "]"}], ":=", 

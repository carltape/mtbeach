Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalLambda]fedorovPRE", "[", 
    RowBox[{"i_", ",", "m_", ",", "nVec_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", "\[Rho]"], 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"c", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i", ",", "j"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"l", ",", "m"}], "}"}]}], "]"}], 
       RowBox[{"nVec", "[", 
        RowBox[{"[", "j", "]"}], "]"}], 
       RowBox[{"nVec", "[", 
        RowBox[{"[", "l", "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "3"}], "}"}]}], "]"}]}]}], "  ", 
  RowBox[{"(*", " ", 
   StyleBox[
    RowBox[{
     RowBox[{"This", " ", "is", " ", "Eq", " ", 
      RowBox[{"(", "15.20", ")"}], " ", "of", " ", "Fedorov", " ", "MAKE", 
      " ", "4"}], "-", "TUPLES"}],
    FontColor->RGBColor[1, 0, 0]], 
   StyleBox[" ",
    FontColor->RGBColor[1, 0, 0]], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalLambda]fedorov", "[", 
   RowBox[{"i_", ",", "m_", ",", "nVec_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["1", "\[Rho]"], 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"cToC", "[", 
       RowBox[{"c", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i", ",", "j"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"l", ",", "m"}], "}"}]}], "]"}], "]"}], 
      RowBox[{"nVec", "[", 
       RowBox[{"[", "j", "]"}], "]"}], 
      RowBox[{"nVec", "[", 
       RowBox[{"[", "l", "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "3"}], "}"}]}], "]"}], "  ", 
   RowBox[{"(*", " ", 
    StyleBox[
     RowBox[{
      RowBox[{"The", " ", "entry", " ", 
       StyleBox[
        SubscriptBox["\[CapitalLambda]", "im"],
        FontSize->24], " ", "of", " ", 
       RowBox[{"Fedorov", "'"}], "s", " ", 
       StyleBox["\[CapitalLambda]",
        FontSize->16]}], "-", "tensor"}],
     FontColor->RGBColor[1, 0, 0]], " ", "*)"}]}]}]}], "Input",
 CellChangeTimes->{{3.8254625941378927`*^9, 3.825462684178856*^9}, {

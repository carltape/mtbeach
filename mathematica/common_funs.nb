Cell[TextData[{
 "Remember that Fmat is the stress arising from strain Emat in the material \
described by ",
 StyleBox["c",
  FontSlant->"Italic"],
 ". \nThen ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["L",
     FontWeight->"Bold",
     FontSlant->"Plain"], "c"], TraditionalForm]],ExpressionUUID->
  "c9db4cf8-5115-4df0-9194-e8183aefcb0c"],
 " is the function that takes strain to stress. But ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["L",
     FontWeight->"Bold",
     FontSlant->"Plain"], "c"], TraditionalForm]],ExpressionUUID->
  "32d0d93d-4c0d-4c9b-bd86-1f935ebcc52e"],
 " seems to depend on the underlying spatial coordinates, so is it really an \
elastic map?"
}], "Subsubsection",
 CellChangeTimes->{{3.784485966855825*^9, 3.7844860394164658`*^9}, {
   3.784486274471085*^9, 3.7844862754085846`*^9}, {3.7844900486130314`*^9, 

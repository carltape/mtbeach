   3.967148227112566*^9, 3.9671483308952184`*^9}, {3.967148736771453*^9, 
   3.96714877945487*^9}, {3.967148822452291*^9, 3.9671488487752*^9}, {
   3.9671490313436546`*^9, 3.9671490899423857`*^9}, {3.967149232117462*^9, 

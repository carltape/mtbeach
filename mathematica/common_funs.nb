 RowBox[{
  RowBox[{
   RowBox[{"cp\[CapitalSigma]prelimFix\[Sigma]", "[", 
    RowBox[{
    "Tmat_", ",", "\[CapitalSigma]_", ",", "colorscheme_", ",", "\[Sigma]0_", 
     ",", "\[Theta]1_", ",", "\[Theta]2_", ",", "contours_", ",", "legends_", 
     ",", "MaxForScaling_", ",", "plotpoints_", ",", "contourstyle_"}], "]"}],
    ":=", 
   RowBox[{

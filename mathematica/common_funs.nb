Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"TildeUofT", "[", 
     RowBox[{"U_", ",", "Tmat_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"MatrixUbar", "[", "U", "]"}], ".", "Tmat", ".", 
     RowBox[{"Transpose", "[", 
      RowBox[{"MatrixUbar", "[", "U", "]"}], "]"}]}]}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   StyleBox[
    RowBox[{
     RowBox[{"used", " ", "to", " ", "be", " ", 
      RowBox[{"Conj", "[", 
       RowBox[{"Tmat", ",", "U"}], "]"}], " ", "or", " ", 
      RowBox[{"ConjByUbar", "[", 
       RowBox[{"Tmat", ",", "U"}], "]"}]}], ";", " ", 
     RowBox[{"watch", " ", "order", " ", "of", " ", "arguments"}]}],
    FontColor->RGBColor[1, 0, 0]], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{

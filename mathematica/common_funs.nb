     RowBox[{
      RowBox[{
       RowBox[{"U", ".", "#", ".", 
        RowBox[{"Transpose", "[", "U", "]"}]}], "&"}], ",", 
      "OrthonormalBasis", ",", "OrthonormalBasis"}], "]"}]}], ";"}], "    ", 

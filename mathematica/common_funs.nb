       {"u21_", "u22_", "u23_"},
       {"u31_", "u32_", "u33_"}
      }], "]"}], ":=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", "u11", "+", "u22", "+", "u33"}], ")"}], 
        RowBox[{"1", "/", "2"}]]}]], 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"u32", "-", "u23"}], ",", 
       RowBox[{"u13", "-", "u31"}], ",", 
       RowBox[{"u21", "-", "u12"}]}], "}"}]}]}], ";"}], 
  RowBox[{"(*", " ", 
   StyleBox[
    RowBox[{
     RowBox[{"In", " ", "RotationAxisExplicit"}], ",", " ", 

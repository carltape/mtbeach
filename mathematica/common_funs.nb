e88fbd8ed9f9"],

Cell[BoxData[{
 RowBox[{"MatrixNote", "[", "Tmat", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<\[Delta]T[Tmat,MONO] = \>\"", ",", 
    RowBox[{"\[Delta]T", "[", 
     RowBox[{"Tmat", ",", "MONO"}], "]"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<\[Delta]T[Tmat,ISO] = \>\"", ",", 
    RowBox[{"\[Delta]T", "[", 
     RowBox[{"Tmat", ",", "ISO"}], "]"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Delta]T", "[", 
   RowBox[{"Tmat", ",", "MONO"}], "]"}], "+", 
  RowBox[{"\[Delta]T", "[", 
   RowBox[{"Tmat", ",", "ISO"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<NormMatrix[Tmat]Sin[MaxAlphaSubSigma[Tmat,MONO] = \>\"", ",", 
    RowBox[{
     RowBox[{"NormMatrix", "[", "Tmat", "]"}], 
     RowBox[{"Sin", "[", 
      RowBox[{
       RowBox[{"MaxAlphaSubSigma", "[", 
        RowBox[{"Tmat", ",", "MONO"}], "]"}], "Degree"}], "]"}]}]}], "]"}], 
  ";"}]}], "Input",

\>\"", ",", 
          RowBox[{"\[CapitalSigma]sWithZero\[Beta]", "[", "Tmat", "]"}], ",", 
          "\"\<  (See the lattice)\>\""}], "]"}], ",", "14", ",", "Bold"}], 

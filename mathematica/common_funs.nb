Italic\"], \"T\"],FontSlant->\"Italic\"]\)\>\"", ",", "14"}], "]"}], ",", 
            " ", "\"\<, where \!\(\*StyleBox[\"U\",FontSlant->\"Italic\"]\) = \
UT[Tmat,\>\"", ",", 
            RowBox[{"\[CapitalSigma]ofT", "[", "Tmat", "]"}], ",", 

Cell[TextData[{
 "Think of (lower case) ",
 StyleBox["c",
  FontSlant->"Italic"],
 " as the function that specifies the 81 (not all distinct) elastic constants \
",
 StyleBox["c",
  FontSlant->"Italic"],
 "[{i, j, k, l}] . \nSo ",
 StyleBox["c",
  FontSlant->"Italic"],
 " is associated with the tensor point of view.\nVoigtMatrixOFc[c] is the \
corresponding Voigt matrix. \nInitially, the command VoigtMatrixOFc just \
specifies how to arrange the 21 cijkl in a 6x6 matrix; we do not yet know the \
conceptual import."
}], "Subsubsection",
 CellChangeTimes->{{3.967146874986561*^9, 3.967147073420354*^9}, {
  3.967506596114954*^9, 
  3.9675067275713882`*^9}},ExpressionUUID->"aaf58846-7d0d-4cf0-833f-\
f6297c631673"],


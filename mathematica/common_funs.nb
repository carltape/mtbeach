      " ", "cannot", " ", "be", " ", 
      RowBox[{"\[Pi]", ".", " ", "If"}], " ", "U", " ", "is", " ", 
      "numerical"}], ",", " ", 
     RowBox[{
     "then", " ", "the", " ", "rotation", " ", "angle", " ", "should", " ", 
      "not", " ", "be", " ", "too", " ", "close", " ", "to", " ", "\[Pi]"}]}],
    FontColor->RGBColor[1, 0, 0]], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{

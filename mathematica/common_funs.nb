    RowBox[{"If", "[", 
     RowBox[{"t1", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", "tkns", "]"}], ",", "       ", 
          RowBox[{"Line", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"c", "+", 
              RowBox[{"u", ".", "#"}]}], "&"}], "/@", 
            RowBox[{"ShortenLineForArrow", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"BBrad", ",", "0", ",", "0"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"lengthAxis", ",", "0", ",", "0"}], "}"}]}], "}"}], 
              ",", "ArrowScale"}], "]"}]}], "]"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Lighting", "\[Rule]", "\"\<Neutral\>\""}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"WantArrowColor", "\[Equal]", "\"\<TriColor\>\""}], ",", 

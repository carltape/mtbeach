Cell[CellGroupData[{

Cell["\<\
MaxAlphaSubSigma and MinAlphaSubSigma are used in getting contours for cp. \
Examples are in the file BC_Sep6_TETwithISO.\
\>", "Subsubsection",
 CellChangeTimes->{{3.91442727974992*^9, 3.914427295601121*^9}, {

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "PreCelSphereList", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eps3", "[", "eye_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Sqrt]", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       FractionBox["1", 
        SuperscriptBox[
         RowBox[{"length", "[", "eye", "]"}], "2"]]}], ")"}]}], 
    RowBox[{"unit", "[", 
     RowBox[{"Cross", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", "eye"}], "]"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"eps4", "[", "eye_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Sqrt]", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       FractionBox["1", 
        SuperscriptBox[
         RowBox[{"length", "[", "eye", "]"}], "2"]]}], ")"}]}], 
    RowBox[{"unit", "[", 
     RowBox[{"Cross", "[", 
      RowBox[{"eye", ",", 
       RowBox[{"eps3", "[", "eye", "]"}]}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"CenterCelSphere", "[", "eye_", "]"}], ":=", 
   FractionBox["eye", 
    SuperscriptBox[
     RowBox[{"length", "[", "eye", "]"}], "2"]]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"CelSpherePt", "[", 
    RowBox[{"t_", ",", "eye_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"CenterCelSphere", "[", "eye", "]"}], "+", 
    RowBox[{
     RowBox[{"cosd", "[", "t", "]"}], " ", 
     RowBox[{"eps3", "[", "eye", "]"}]}], "+", 
    RowBox[{
     RowBox[{"sind", "[", "t", "]"}], " ", 
     RowBox[{"eps4", "[", "eye", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PreCelSphereList", "[", "eye_", "]"}], ":=", 
    RowBox[{
     RowBox[{"PreCelSphereList", "[", "eye", "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"CelSpherePt", "[", 
        RowBox[{"#", ",", "eye"}], "]"}], "&"}], "/@", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{"-", "90."}], ",", "270"}], "]"}]}]}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", "180"}], "]"}], "*)"}]}]}], "Input",

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ff", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"i_", ",", "j_"}], "}"}], ",", "Emat_", ",", "c_"}], "]"}], ":=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"c", "[", 
        RowBox[{"Canonical", "[", 
         RowBox[{"{", 
          RowBox[{"i", ",", "j", ",", "kk", ",", "ll"}], "}"}], "]"}], "]"}], 
       RowBox[{"Emat", "[", 
        RowBox[{"[", 
         RowBox[{"kk", ",", "ll"}], "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"kk", ",", "1", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"ll", ",", "1", ",", "3"}], "}"}]}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   StyleBox[
    RowBox[{
     RowBox[{"Eq", " ", 
      RowBox[{"(", "2", ")"}], " ", "of", " ", 
      RowBox[{"TT2021", ".", " ", "Changed"}], " ", "July", " ", "10"}], ",", 
     " ", 
     RowBox[{
      RowBox[{
